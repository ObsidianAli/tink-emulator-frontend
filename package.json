{
  "name": "tink",
  "version": "0.6.1",
  "author": "ObsidianAli",
  "description": "A small, controller-friendly game launcher for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win portable --publish never && node scripts/zip.js",
    "e2e": "node test/shelf.e2e.js"
  },
  "build": {
    "appId": "dev.tink.launcher",
    "productName": "Tink",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "!node_modules/three/examples/**",
      "!node_modules/three/src/**",
      "!node_modules/three/build/three.cjs",
      "!node_modules/three/build/three.tsl.js",
      "!node_modules/three/build/three.webgpu*.js"
    ],
    "asarUnpack": [
      "node_modules/@koromix/koffi-win32-x64/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "artifactName": "Tink.exe"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.1"
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "three": "^0.187.0"
  }
}
